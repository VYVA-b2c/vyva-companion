# Core
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/vyva
# Vercel deployments may use POSTGRES_URL, POSTGRES_PRISMA_URL, or POSTGRES_URL_NON_POOLING instead.
JWT_SECRET=replace-with-a-long-random-secret

# Supabase auth
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MEDISEARCH_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_BRAIN_TTS_VOICE_ID=
ELEVENLABS_MEDITATION_TTS_VOICE_ID=
ELEVENLABS_MEDITATION_AGENT_ID=
ELEVENLABS_COMPANION_AGENT_ID=
ELEVENLABS_SAFETY_AGENT_ID=
ELEVENLABS_MEDS_AGENT_ID=
ELEVENLABS_HEALTH_AGENT_ID=
ELEVENLABS_DR_AI_AGENT_ID=
ELEVENLABS_DR_AI_VOICE_ID=
# HMAC secret shown when configuring the ElevenLabs post-call webhook.
ELEVENLABS_POST_CALL_WEBHOOK_SECRET=
# Optional comma-separated allowlist. Defaults to ELEVENLABS_DR_AI_AGENT_ID.
ELEVENLABS_ADMIN_REVIEW_AGENT_IDS=
# VYVA stops retrieving provider content after this window (default 30, max 365).
ELEVENLABS_CONVERSATION_RETENTION_DAYS=30
# Public HTTPS application origin used by the ElevenLabs webhook tool.
VYVA_PUBLIC_URL=https://v2.vyva.life
# disabled | pilot | active. Defaults to disabled when omitted or invalid.
VYVA_DR_AI_VOICE_MODE=disabled
# Comma-separated authenticated user IDs; used only in pilot mode.
VYVA_DR_AI_VOICE_PILOT_USER_IDS=
ELEVENLABS_CONCIERGE_AGENT_ID=
ELEVENLABS_BRAIN_COACH_AGENT_ID=
MEM0_API_KEY=
# Consent-gated health semantic memory. Keep disabled unless migration 0081 is applied.
# In production, pilot mode also requires ALLOW_PRODUCTION=true and either an
# explicit allowlist entry or a non-zero rollout value (0-10000 basis points).
VYVA_HEALTH_PREVENTIVE_MEMORY_POLICY_MODE=disabled
VYVA_HEALTH_PREVENTIVE_MEMORY_POLICY_ALLOW_USERS=
VYVA_HEALTH_PREVENTIVE_MEMORY_POLICY_DENY_USERS=
VYVA_HEALTH_PREVENTIVE_MEMORY_POLICY_ROLLOUT_BPS=0
VYVA_HEALTH_PREVENTIVE_MEMORY_POLICY_ALLOW_PRODUCTION=false

# Meta publishing connection (configured on the Admin deployment, not the public website project).
# The OAuth redirect must exactly match the URL configured in the Meta developer app.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v24.0
META_OAUTH_REDIRECT_URI=https://v2.vyva.life/api/admin/marketing/social-publishing/meta/callback
# Optional separate encryption key for connected provider credentials. JWT_SECRET is used when omitted.
MARKETING_CONNECTION_ENCRYPTION_KEY=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5000
VITE_PUBLIC_APP_URL=https://v2.vyva.life
STRIPE_PREMIUM_PRICE_ID=
# Optional per-plan Stripe price IDs can also be stored in the admin Plans & Tiers screen.

# Browser push notifications (generate with: npx web-push generate-vapid-keys --json)
VYVA_WEB_PUSH_VAPID_PUBLIC_KEY=
VYVA_WEB_PUSH_VAPID_PRIVATE_KEY=
VYVA_WEB_PUSH_VAPID_SUBJECT=https://vyva.life

# Admin/API integrations
SUPER_ADMIN_EMAIL=karim.assad@mokadigital.net
VITE_SUPER_ADMIN_EMAIL=karim.assad@mokadigital.net
GOOGLE_PLACES_API_KEY=
# Auth/reset emails use Resend.
RESEND_API_KEY=
SENDGRID_API_KEY=
# Must match a verified sender/domain in the active email provider.
NOTIFY_FROM_EMAIL=verified-sender@example.com
# Optional reply-to shown when recipients reply to VYVA emails.
NOTIFY_REPLY_TO_EMAIL=
# Resend Receiving address and signing secrets for automatic Concierge replies.
CONCIERGE_EMAIL_INBOUND_ADDRESS=
CONCIERGE_EMAIL_INBOUND_WEBHOOK_SECRET=
CONCIERGE_EMAIL_REPLY_SECRET=
# Optional aliases supported by email helpers.
RESEND_FROM_EMAIL=
SENDGRID_FROM_EMAIL=
EMAIL_FROM=

# Communications dispatcher
# Set COMMUNICATION_DISPATCH_INTERVAL_MS to enable automatic queue draining.
COMMUNICATION_DISPATCH_INTERVAL_MS=
COMMUNICATION_DISPATCH_BATCH_SIZE=25
CONSENT_MAX_ATTEMPTS=3
CONSENT_RETRY_DELAYS_MINUTES=30,120
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Preferred direct SMS sender. Set this to the US SMS-capable Twilio number.
TWILIO_US_SMS_FROM_NUMBER=
TWILIO_SMS_MESSAGING_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
TWILIO_VOICE_FROM_NUMBER=
TWILIO_CONSENT_CALL_URL=
# Optional public HTTPS base used for Twilio delivery and voice callbacks.
# Leave blank for local development; local sends will skip callbacks.
TWILIO_WEBHOOK_BASE_URL=https://v2.vyva.life
