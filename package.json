{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"PORT=3001 tsx server/index.ts\" \"vite\"",
    "dev:replit": "cross-env PORT=5000 NODE_ENV=development tsx server/index.ts",
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite",
    "preview:adherence": "node scripts/preview-adherence-report.mjs",
    "db:audit": "node scripts/db-audit.mjs",
    "db:audit:json": "node scripts/db-audit.mjs --json",
    "db:push": "echo \"db:push disabled; use reviewed SQL migrations\"",
    "db:push:manual": "cross-env ALLOW_DRIZZLE_SCHEMA_PUSH=true drizzle-kit push --config scripts/drizzle.manual.config.ts",
    "db:auth": "node scripts/apply-auth-schema.mjs",
    "db:concierge": "node scripts/apply-concierge-schema.mjs",
    "db:publish-runtime": "node scripts/apply-publish-runtime-schema.mjs",
    "db:health-insights": "node scripts/apply-health-insights-schema.mjs",
    "db:longevity-preview-content": "node scripts/activate-longevity-preview-content.mjs",
    "db:lifecycle-contact-cleanup": "node scripts/apply-lifecycle-contact-cleanup.mjs",
    "concierge:email-pilot:check": "tsx scripts/concierge-email-pilot-check.ts",
    "canvas:qa:analytics": "tsx scripts/validate-voice-canvas-analytics-evidence.ts",
    "canvas:qa:copy": "tsx scripts/prepare-voice-canvas-copy-evidence.ts",
    "canvas:qa:entry-surfaces": "tsx scripts/prepare-voice-canvas-entry-surface-evidence.ts",
    "canvas:qa:features": "tsx scripts/collect-voice-canvas-feature-endpoint-evidence.ts",
    "canvas:qa:packet": "tsx scripts/validate-voice-canvas-evidence-packet.ts",
    "canvas:qa:preflight": "tsx scripts/preflight-voice-canvas-launch-readiness.ts",
    "canvas:qa:recovery": "tsx scripts/prepare-voice-canvas-recovery-evidence.ts",
    "canvas:qa:real-use": "tsx scripts/prepare-voice-canvas-real-use-evidence.ts",
    "canvas:qa:run": "tsx scripts/prepare-voice-canvas-launch-evidence-run.ts",
    "canvas:qa:runsheet": "tsx scripts/validate-voice-canvas-run-sheet.ts",
    "canvas:qa:rollback-owner": "tsx scripts/prepare-voice-canvas-rollback-owner-handoff.ts",
    "canvas:qa:validate": "tsx scripts/validate-voice-canvas-qa-matrix.ts",
    "qa:manual:preflight": "node scripts/manual-qa-preflight.mjs",
    "voice:coverage:audit": "tsx scripts/audit-cross-pillar-voice-coverage.ts",
    "voice:dr-ai:provision": "node scripts/provision-dr-ai-agent.mjs",
    "voice:dr-ai:verify-live": "node scripts/provision-dr-ai-agent.mjs --verify-live",
    "db:migrate": "cross-env DATABASE_URL=file:./dev.db prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260624120000_init_brain_wellbeing/migration.sql && cross-env DATABASE_URL=file:./dev.db prisma generate --schema prisma/schema.prisma",
    "db:seed": "cross-env DATABASE_URL=file:./dev.db prisma db seed --schema prisma/schema.prisma",
    "db:reset": "cross-env DATABASE_URL=file:./dev.db tsx prisma/reset.ts",
    "db:studio": "cross-env DATABASE_URL=file:./dev.db prisma studio --schema prisma/schema.prisma",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=server-dist/index.cjs --packages=external",
    "build": "npm run build:client && npm run build:server",
    "build:dev": "vite build --mode development",
    "start": "cross-env NODE_ENV=production node ./server-dist/index.cjs",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "preview:symptom-flow": "cross-env NODE_ENV=development PORT=8125 DATABASE_URL=postgresql://127.0.0.1:1/vyva_local_preview tsx scripts/preview-symptom-flow.ts",
    "test:e2e": "playwright test",
    "test": "node scripts/run-vitest.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
